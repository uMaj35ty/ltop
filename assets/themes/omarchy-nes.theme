# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#101010"

# Main text color
theme[main_fg]="#cecfc9"

# Title color for boxes
theme[title]="#cecfc9"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#9a9d9a"

# Background color of selected item in processes box
theme[selected_bg]="#1f1f1f"

# Foreground color of selected item in processes box
theme[selected_fg]="#9a9d9a"

# Color of inactive/disabled text
theme[inactive_fg]="#525351"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#d8d9d4"

# Background color of the percentage meters
theme[meter_bg]="#1f1f1f"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#d8d9d4"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#d93f37"
theme[mem_box]="#9a9d9a"
theme[net_box]="#d93f37"
theme[proc_box]="#9a9d9a"

# Box divider line and small boxes line color
theme[div_line]="#525351"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#9a9d9a"
theme[temp_mid]="#9a9d9a"
theme[temp_end]="#d93f37"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#9a9d9a"
theme[cpu_mid]="#9a9d9a"
theme[cpu_end]="#d93f37"

# Mem/Disk free meter
theme[free_start]="#d93f37"
theme[free_mid]="#9a9d9a"
theme[free_end]="#9a9d9a"

# Mem/Disk cached meter
theme[cached_start]="#9a9d9a"
theme[cached_mid]="#9a9d9a"
theme[cached_end]="#d93f37"

# Mem/Disk available meter
theme[available_start]="#9a9d9a"
theme[available_mid]="#d93f37"
theme[available_end]="#d93f37"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#9a9d9a"
theme[used_mid]="#9a9d9a"
theme[used_end]="#9a9d9a"

# Download graph colors
theme[download_start]="#9a9d9a"
theme[download_mid]="#d93f37"
theme[download_end]="#d93f37"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#9a9d9a"
theme[upload_mid]="#9a9d9a"
theme[upload_end]="#9a9d9a"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#9a9d9a"
theme[process_mid]="#9a9d9a"
theme[process_end]="#d93f37"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#101010"
theme[gradient_color_1]="#1f1f1f"
theme[gradient_color_2]="#1f1f1f"
theme[gradient_color_3]="#525351"
theme[gradient_color_4]="#9d9f93"
theme[gradient_color_5]="#cecfc9"
theme[gradient_color_6]="#d8d9d4"
theme[gradient_color_7]="#e7e7e4"
