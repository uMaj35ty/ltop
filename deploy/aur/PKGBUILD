# Maintainer: uMaj35ty <arcadelogic@foxmail.com>
pkgname=ltop-bin
pkgver=0.2.1
pkgrel=1
pkgdesc="btop-styled TUI monitoring for local network, LAN neighbours and disk I/O"
arch=($CARCH)
url="https://github.com/uMaj35ty/ltop"
license=('MIT')
depends=('glibc' 'gcc-libs')
optdepends=('clang: rebuild from source with eBPF accounting'
            'sudo: deploy the ltop-bpf helper service')
provides=('ltop' 'ltop-bpf' 'loli')
conflicts=('localist-top' 'localist-top-bin')
source=("ltop-$pkgver-x86_64-linux.tar.gz::$url/releases/download/v$pkgver/ltop-$pkgver-x86_64-linux.tar.gz"
        "ltop-bpf.service::$url/raw/v$pkgver/deploy/ltop-bpf.service")
sha256sums=('9006dfacbf84a42332ea43ac8c2eacdabc1969b4ea9b38e8fa12bd75b092b6b9'
            'e981e88878ef77ab9976645696abf7b3dd2aa43b40770be53b2ab43fc0921c7f')
options=('!strip')

package() {
    install -Dm755 "$srcdir/ltop" "$pkgdir/usr/bin/ltop"
    install -Dm755 "$srcdir/ltop-bpf" "$pkgdir/usr/bin/ltop-bpf"
    # 开箱别名:与 Release tarball 同口径
    ln -s ltop "$pkgdir/usr/bin/loli"
    install -Dm644 "$srcdir/ltop-bpf.service" "$pkgdir/usr/lib/systemd/system/ltop-bpf.service"
}
